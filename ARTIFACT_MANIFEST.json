{
  "schema_version": 1,
  "title": "MPSC dataset artifact manifest",
  "integrity_verification_command": "python code/scripts/verify_artifact_manifest.py",
  "integrity_refresh_command": "python code/scripts/verify_artifact_manifest.py --write",
  "integrity_policy": {
    "text_strategy": "sha256_lf_normalized_text",
    "text_normalization": "replace CRLF with LF, then replace remaining CR with LF",
    "text_extensions": [
      ".cff",
      ".cfg",
      ".csv",
      ".ini",
      ".json",
      ".md",
      ".ps1",
      ".py",
      ".rst",
      ".sh",
      ".sol",
      ".toml",
      ".txt",
      ".yaml",
      ".yml"
    ],
    "text_basenames": [],
    "binary_strategy": "sha256_bytes",
    "tree_strategy": "recursive_mixed_content_sha256",
    "tree_record_format": "relative_path NUL digest_kind NUL content_sha256 LF, sorted by path"
  },
  "path_policy": {
    "immutable_roots": [
      "experiment-data/results/canonical/"
    ],
    "rule": "Paths embedded in preserved run records describe the layout at execution time."
  },
